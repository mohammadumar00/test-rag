# Local services
OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333

# Models to be used by future indexing and query pipelines
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.2

# Indexer
QDRANT_COLLECTION=react_docs
SOURCE_URL_BASE=https://react.dev/reference/react
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
EMBEDDING_BATCH_SIZE=16
QDRANT_UPSERT_BATCH_SIZE=32

# API
API_PORT=3001
RAG_TOP_K=4
RAG_MAX_CONTEXT_CHARACTERS=9000

# Web (optional; defaults to http://localhost:3001)
VITE_API_URL=http://localhost:3001
